{
  "searchIndexCap": 3,
  "searchIndexes": [
    {
      "collection": "voiceprints",
      "name": "voiceprints_vector",
      "type": "vectorSearch",
      "definition": {
        "fields": [
          {"type": "vector", "path": "embedding", "numDimensions": 192, "similarity": "cosine"},
          {"type": "filter", "path": "owner_id"},
          {"type": "filter", "path": "person_id"}
        ]
      }
    },
    {
      "collection": "facts",
      "name": "facts_vector",
      "type": "vectorSearch",
      "definition": {
        "fields": [
          {"type": "vector", "path": "embedding", "numDimensions": 768, "similarity": "cosine"},
          {"type": "filter", "path": "owner_id"},
          {"type": "filter", "path": "person_id"}
        ]
      }
    },
    {
      "collection": "facts",
      "name": "facts_text",
      "type": "search",
      "definition": {
        "mappings": {
          "dynamic": false,
          "fields": {
            "claim": {"type": "string", "analyzer": "lucene.standard"},
            "attribute": {"type": "string", "analyzer": "lucene.standard"},
            "owner_id": {"type": "token"},
            "person_id": {"type": "token"}
          }
        }
      }
    }
  ],
  "collectionIndexes": [
    {
      "collection": "people",
      "keys": {"owner_id": 1, "name": 1},
      "options": {"name": "people_by_name"}
    },
    {
      "collection": "people",
      "keys": {"owner_id": 1, "is_owner": 1},
      "options": {"name": "people_owner"}
    },
    {
      "collection": "conversations",
      "keys": {"owner_id": 1, "started_at": -1},
      "options": {"name": "conversations_recent"}
    },
    {
      "collection": "conversations",
      "keys": {"owner_id": 1, "participant_ids": 1},
      "options": {"name": "conversations_by_participant"}
    },
    {
      "collection": "facts",
      "keys": {"owner_id": 1, "primary_source_utterance_id": 1, "claim_normalized": 1},
      "options": {"name": "facts_idempotency", "unique": true}
    },
    {
      "collection": "facts",
      "keys": {"owner_id": 1, "person_id": 1, "attribute": 1, "superseded_by": 1},
      "options": {"name": "facts_current_by_attribute"}
    },
    {
      "collection": "facts",
      "keys": {"owner_id": 1, "superseded_by": 1, "superseded_at": -1},
      "options": {"name": "facts_supersession_recent"}
    },
    {
      "collection": "facts",
      "keys": {"owner_id": 1, "embedding_pending_since": 1},
      "options": {"name": "facts_embedding_backfill", "sparse": true}
    },
    {
      "collection": "promises",
      "keys": {"owner_id": 1, "source_utterance_id": 1, "text_normalized": 1},
      "options": {"name": "promises_idempotency", "unique": true}
    },
    {
      "collection": "promises",
      "keys": {"owner_id": 1, "status": 1, "due_at": 1},
      "options": {"name": "promises_open_by_due"}
    },
    {
      "collection": "voiceprints",
      "keys": {"owner_id": 1, "person_id": 1},
      "options": {"name": "voiceprints_by_person"}
    },
    {
      "collection": "utterances",
      "keys": {"owner_id": 1, "conversation_id": 1, "start_ms": 1},
      "options": {"name": "conversation_timeline"}
    },
    {
      "collection": "utterances",
      "keys": {"text": "text"},
      "options": {"name": "utterances_fulltext"}
    },
    {
      "collection": "reminders",
      "keys": {"owner_id": 1, "status": 1, "fire_at": 1},
      "options": {"name": "reminders_scheduled"}
    },
    {
      "collection": "reminders",
      "keys": {"owner_id": 1, "promise_id": 1},
      "options": {"name": "reminders_by_promise"}
    }
  ]
}

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/amelia
# Lane B (memory, extraction, embeddings) and any other lane on Fireworks
FIREWORKS_API_KEY=
# Lane D only; drop if Amelia also moves to Fireworks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PYANNOTE_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
PORT=3000

# Lane D (Amelia). Only ANTHROPIC_API_KEY is required: without ELEVENLABS_API_KEY
# she answers silently, without RESEND_* drafts are created but cannot be sent.
# Sending domain must be verified; fallback while DNS propagates: onboarding@resend.dev
RESEND_FROM="Amelia <amelia@yourdomain.com>"
AMELIA_EFFORT=medium            # low | medium | high — demo latency lives here
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
AMELIA_AUDIO_DIR=/tmp/amelia-audio

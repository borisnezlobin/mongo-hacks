# --- storage ---------------------------------------------------------------
# Amelia is local-first. Atlas is an optional sync target, not a requirement:
# identity has to keep working on a campus network that blocks or firewalls the
# cluster, which is the normal case, not the exception.
#
# Unset MONGODB_URI, or leave it set and unreachable, and the server stores
# everything in AMELIA_DATA_DIR and reports `storage.degraded` on GET /health.
# AMELIA_STORAGE=local forces local even when Atlas is reachable; `mongo` fails
# loudly instead of falling back.
AMELIA_DATA_DIR=~/.amelia/data
# AMELIA_STORAGE=local
AMELIA_MONGO_TIMEOUT_MS=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/amelia
# Lane B (memory, extraction, embeddings) and any other lane on Fireworks
FIREWORKS_API_KEY=
# Lane D only; drop if Amelia also moves to Fireworks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Lane A STT. The default (gpt-4o-transcribe-diarize) carries speaker labels but
# is a gated model — most orgs get "does not have access to this transcription
# model" and the pipeline then emits ZERO utterances while audio keeps arriving.
# gpt-4o-transcribe / gpt-4o-mini-transcribe / whisper-1 are ungated; they drop
# diarisation, so each server-VAD turn becomes one speaker and voiceprint
# identity does the attribution. gpt-live-transcribe rejects turn_detection.
# Live streaming transcription. The realtime endpoint does not serve the
# diarizing model, so speaker labels come from the batch final pass instead.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Server-VAD trailing silence. 200 ms shattered the last ten seconds of the
# dorm recording into one- and two-word turns, which carry no usable voiceprint.
OPENAI_SILENCE_MS=500
# When recording stops, the retained audio is transcribed by whisper and
# diarized by pyannote in the sidecar, the two are joined at word level, and the
# transcript is rebuilt in place under the same utterance ids.
#   on   (default) the correction runs. It costs a whisper transcription and,
#        for the diarization, about as long as the recording itself on CPU.
#   off  live pass only: text is right, speakers are the live clustering's guess.
AUDIO_FINAL_PASS=on
# The final pass needs the session audio on disk. Bounded and gitignored.
# AUDIO_RETAIN=off disables retention, which also disables the final pass.
AUDIO_RETAIN_DIR=.recordings
AUDIO_RETAIN_MAX_MS=2700000
# EMBED_MIN_MS / PROVISIONAL_SPEECH_MS / CONFIRMED_SPEECH_MS / ATTRIBUTION_THRESHOLD
# are deliberately unset: shared/contracts.ts holds the measured values, and
# server/audio/config.ts refuses any override that loosens a measured floor.
# Re-measure with `bun run eval:speakers` before changing them here.
# pyannote's diarization weights are gated on Hugging Face. Without this the
# sidecar still embeds voiceprints and /health reports diarization: false, so
# the final pass has nothing to correct against and says so.
HF_TOKEN=
PYANNOTE_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
PORT=3000
MENTRAOS_API_KEY=

# --- Lane D (Amelia) --------------------------------------------------------
# Model provider. Unset = auto: ANTHROPIC_API_KEY if present, else FIREWORKS.
# anthropic -> claude-opus-5 (Messages API, adaptive thinking, no temperature)
# fireworks -> open-weights model (OpenAI-compatible, temperature 0)
AMELIA_PROVIDER=fireworks
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3
ANTHROPIC_MODEL=claude-opus-5
AMELIA_EFFORT=medium            # anthropic only: low | medium | high
AMELIA_MAX_TOKENS=

# Without ELEVENLABS_API_KEY she answers silently; without RESEND_* drafts are
# created but cannot be sent. Sending domain must be verified; fallback while
# DNS propagates: onboarding@resend.dev
RESEND_FROM="Amelia <onboarding@resend.dev>"
ELEVENLABS_MODEL=eleven_flash_v2_5
# Must be a `premade` voice on the free tier — library voices return HTTP 402.
# GET /v1/voices lists what your key can actually use.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
AMELIA_AUDIO_DIR=/tmp/amelia-audio
OWNER_PERSON_ID=p-amelia-owner

# --- Lane A (identity) ------------------------------------------------------
# Raw-cosine gap the best candidate must beat the runner-up (a DIFFERENT person)
# by. 0 = off, exactly today's "take the top candidate over 0.6". Above 0, two
# people who both clear the threshold and sit closer than this return
# pending/ambiguous instead of a coin-flip match, and the session retries with
# more pooled speech. Try 0.05.
IDENTITY_MARGIN_COSINE=0
# Only consulted after an ambiguous result. Pooled speech must grow by this much
# before re-attempting; re-embedding the same clip returns the same vector.
ATTRIBUTION_RETRY_SPEECH_MS=
# Ambiguous retries before the speaker is decided the way main decides today.
ATTRIBUTION_MAX_ATTEMPTS=3

# Opt-in shared secret for the HTTP surface. Unset = open (localhost default).
# When set, every route but /health requires "Authorization: Bearer <key>" —
# external callers like siyi send it. /stream (WebSocket) is not covered.
AMELIA_API_KEY=

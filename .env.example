MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/amelia
# Lane B (memory, extraction, embeddings) and any other lane on Fireworks
FIREWORKS_API_KEY=
# Lane D only; drop if Amelia also moves to Fireworks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Lane A STT. The default (gpt-4o-transcribe-diarize) carries speaker labels but
# is a gated model — most orgs get "does not have access to this transcription
# model" and the pipeline then emits ZERO utterances while audio keeps arriving.
# gpt-4o-transcribe / gpt-4o-mini-transcribe / whisper-1 are ungated; they drop
# diarisation, so each server-VAD turn becomes one speaker and voiceprint
# identity does the attribution. gpt-live-transcribe rejects turn_detection.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
PYANNOTE_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
PORT=3000
MENTRAOS_API_KEY=

# --- Lane D (Amelia) --------------------------------------------------------
# Model provider. Unset = auto: ANTHROPIC_API_KEY if present, else FIREWORKS.
# anthropic -> claude-opus-5 (Messages API, adaptive thinking, no temperature)
# fireworks -> open-weights model (OpenAI-compatible, temperature 0)
AMELIA_PROVIDER=fireworks
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3
ANTHROPIC_MODEL=claude-opus-5
AMELIA_EFFORT=medium            # anthropic only: low | medium | high
AMELIA_MAX_TOKENS=

# Without ELEVENLABS_API_KEY she answers silently; without RESEND_* drafts are
# created but cannot be sent. Sending domain must be verified; fallback while
# DNS propagates: onboarding@resend.dev
RESEND_FROM="Amelia <onboarding@resend.dev>"
ELEVENLABS_MODEL=eleven_flash_v2_5
# Must be a `premade` voice on the free tier — library voices return HTTP 402.
# GET /v1/voices lists what your key can actually use.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
AMELIA_AUDIO_DIR=/tmp/amelia-audio
OWNER_PERSON_ID=p-amelia-owner

# --- Lane A (identity) ------------------------------------------------------
# Raw-cosine gap the best candidate must beat the runner-up (a DIFFERENT person)
# by. 0 = off, exactly today's "take the top candidate over 0.6". Above 0, two
# people who both clear the threshold and sit closer than this return
# pending/ambiguous instead of a coin-flip match, and the session retries with
# more pooled speech. Try 0.05.
IDENTITY_MARGIN_COSINE=0
# Only consulted after an ambiguous result. Pooled speech must grow by this much
# before re-attempting; re-embedding the same clip returns the same vector.
ATTRIBUTION_RETRY_SPEECH_MS=
# Ambiguous retries before the speaker is decided the way main decides today.
ATTRIBUTION_MAX_ATTEMPTS=3

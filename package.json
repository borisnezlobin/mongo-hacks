{
  "name": "amelia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@amelia/server",
    "dev:app": "npm run start --workspace=@amelia/app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "node db/apply-indexes.mjs",
    "seed": "node fixtures/seed.mjs",
    "eval:attribution": "tsx eval/attribution.mts",
    "eval:fixture": "python3 eval/generate-fixture.py",
    "sync": "node scripts/sync.mjs",
    "watch": "node scripts/watch-main.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@elevenlabs/elevenlabs-js": "^2.63.0",
    "@hono/node-server": "^1.19.1",
    "@mentra/sdk": "^2.1.20",
    "hono": "^4.9.4",
    "mongodb": "^6.19.0",
    "resend": "^6.0.2",
    "voyageai": "^0.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.7",
    "@types/ws": "^8.18.1",
    "react-native": "0.86.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
